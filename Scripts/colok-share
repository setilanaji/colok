#!/bin/bash
# colok-share - the only thing Colok is allowed to run as root for Internet Sharing.
#
# Installed to /usr/local/libexec/colok-share, owned by root, mode 0755, so an
# unprivileged user cannot alter what runs with elevated rights. Every argument
# is validated here rather than in sudoers, because sudoers cannot express
# "a BSD interface name" or "a service UUID".
set -euo pipefail

PLIST=/Library/Preferences/SystemConfiguration/com.apple.nat.plist
DAEMON=/System/Library/LaunchDaemons/com.apple.InternetSharing.plist
LABEL=system/com.apple.InternetSharing

die() { echo "$*" >&2; exit 1; }
valid_device() { [[ "$1" =~ ^(en|bridge|ap)[0-9]{1,3}$ ]]; }
valid_uuid()   { [[ "$1" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]]; }
valid_ssid()   { [[ ${#1} -ge 1 && ${#1} -le 32 && "$1" =~ ^[[:print:]]+$ ]]; }

running() { /bin/launchctl print "$LABEL" >/dev/null 2>&1; }

write_plist() {
  local svc="$1" dev="$2" wifi_out="$3" ssid="$4"
  [[ -f "$PLIST" ]] && cp -p "$PLIST" "${PLIST}.colok-backup" 2>/dev/null || true
  cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NAT</key>
    <dict>
        <key>AirPort</key>
        <dict>
            <key>40BitEncrypt</key><integer>1</integer>
            <key>Channel</key><integer>0</integer>
            <key>Enabled</key><integer>${wifi_out}</integer>
            <key>NetworkName</key><string>${ssid}</string>
        </dict>
        <key>Enabled</key><integer>1</integer>
        <key>NatPortMapDisabled</key><false/>
        <key>PrimaryService</key><string>${svc}</string>
        <key>SharingDevices</key>
        <array><string>${dev}</string></array>
    </dict>
</dict>
</plist>
PLISTEOF
  chmod 0644 "$PLIST"
}

case "${1:-}" in
  status)
    running && echo running || echo stopped
    ;;

  enable)
    svc="${2:-}"; dev="${3:-}"; ssid="${4:-}"
    valid_uuid "$svc"   || die "invalid service uuid"
    valid_device "$dev" || die "invalid sharing device"

    # Sharing out over the Wi-Fi radio only makes sense when the uplink is not
    # Wi-Fi; the caller decides, we just record which mode was asked for.
    wifi_out=0
    if [[ -n "$ssid" ]]; then
      valid_ssid "$ssid" || die "invalid ssid"
      wifi_out=1
    fi

    write_plist "$svc" "$dev" "$wifi_out" "$ssid"

    /bin/launchctl enable "$LABEL" 2>/dev/null || true
    if ! /bin/launchctl kickstart -k "$LABEL" 2>/dev/null; then
      /bin/launchctl load -w "$DAEMON" 2>/dev/null || die "could not start InternetSharing"
    fi
    sleep 1
    running && echo running || die "InternetSharing did not stay up - check Console for com.apple.InternetSharing"
    ;;

  disable)
    if [[ -f "$PLIST" ]]; then
      /usr/bin/defaults write "${PLIST%.plist}" NAT -dict-add Enabled -int 0 2>/dev/null || true
    fi
    /bin/launchctl bootout "$LABEL" 2>/dev/null || /bin/launchctl unload -w "$DAEMON" 2>/dev/null || true
    echo stopped
    ;;

  *)
    die "usage: colok-share status | enable <serviceUUID> <device> [ssid] | disable"
    ;;
esac
